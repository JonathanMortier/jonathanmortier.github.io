---
interface Props {
  title: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  tags?: string[];
}

const site = "https://jonathanmortier.github.io";
const {
  title,
  description = "Jonathan Mortier, Lead Developer Fullstack Java / Angular / React, consultant freelance à Niort. Applications web et mobiles, conseil en transformation digitale au sein de Wekey.",
  type = "website",
  publishedTime,
  tags = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = `${site}/og.image.png`;

const person = {
  "@type": "Person",
  "@id": `${site}/#jonathan-mortier`,
  name: "Jonathan Mortier",
  url: site,
  image: ogImage,
  jobTitle: "Lead Developer Fullstack Java / Angular / React",
  description,
  worksFor: { "@type": "Organization", name: "Wekey", url: "https://wekey.fr/" },
  address: { "@type": "PostalAddress", addressLocality: "Niort", addressCountry: "FR" },
  knowsAbout: ["Java", "Spring Boot", "Angular", "React", "Android", "Transformation digitale"],
  sameAs: [
    "https://github.com/JonathanMortier",
    "https://www.linkedin.com/in/jonathan-mortier-990a007b/",
  ],
};

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title.replace(/ \| Jonathan Mortier$/, ""),
        description,
        mainEntityOfPage: canonical,
        datePublished: publishedTime?.toISOString(),
        inLanguage: "fr-FR",
        keywords: tags.join(", "),
        image: ogImage,
        author: person,
      }
    : { "@context": "https://schema.org", ...person };
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jonathan Mortier" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog de Jonathan Mortier"
      href="/rss.xml"
    />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Jonathan Mortier" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    color-scheme: dark;
    --background: #0a0a10;
    --sec: #b99cff;
    --white: #f5f5f8;
    --white-strong: #ffffff;
    --white-icon: #b9b9c6;
    --white-icon-tr: #ffffff26;
    --card-bg: #16161f;
    --component-bg: #12121bee;
    --line-soft: #ffffff1f;
    --footer-icon-filter: brightness(0) invert(1);
  }

  :root[data-theme="light"] {
    color-scheme: light;
    --background: #ffffff;
    --sec: #5a2ec2;
    --white: #14121c;
    --white-strong: #000000;
    --white-icon: #4a4658;
    --white-icon-tr: #14121c33;
    --card-bg: #f1eefa;
    --component-bg: #ffffffee;
    --line-soft: #14121c26;
    --footer-icon-filter: brightness(0);
  }

  :root[data-theme="light"] .shiny-sec {
    background: linear-gradient(135deg, #5a2ec2 25%, #9a78ec 50%, #5a2ec2 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .invert { filter: var(--footer-icon-filter) !important; }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
